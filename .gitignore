# --- user data: never commit the manuals themselves (RULES.md 4.4) ---
data/manuals/*
!data/manuals/.gitkeep
MEMORY.md
.backboard/

# --- generated output ---
out/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- local state ---
*.db
*.db-wal
*.db-shm
# The deploy seed is the ONE committed database: it is how a stateless free-tier
# deploy gets the scan's verified result (deploy/build-seed.sh refreshes it; see
# DOCS/DEPLOY.md). Everything else under out/, blab/, snapshots/ stays ignored.
!deploy/seed/*.db

# --- secrets ---
.env

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
